# Copy to /etc/default/labshare, edit, then:  sudo chmod 600 /etc/default/labshare
LABSHARE_WIFI=wlp2s0
LABSHARE_SSID=LabShare
LABSHARE_PASSWORD=ChangeThisPassword
LABSHARE_PORT=50555
LABSHARE_DB=/var/lib/labshare/labshare.db
# Optional: clients must supply this token too
#LABSHARE_TOKEN=lab-secret
